# Copie para `.env` e preencha só no computador local (não commitar valores).
GEMINI_API_KEY=

# Vercel Postgres / Neon — registo/login, sessões em cookie httpOnly e histórico IA na conta.
# DATABASE_URL=

# Ou variáveis que a Vercel define ao criar Postgres (o código aceita QUALQUER UMA na ordem):
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=

# Opcional (padrão no código: gemini-2.5-flash — deve ser um dos IDs em shared/geminiAllowedModels.ts)
# GEMINI_MODEL=gemini-2.5-flash

# Futuro: campo “modelo avançado” na UI (só se implementado no servidor)
# GEMINI_ALLOW_ADVANCED_MODEL_PICKER=1

# Opcional: com `npm run dev`, encaminha `/api/*` para este URL (ex.: deploy na Vercel) para testar a página /ia sem `vercel dev`.
# DEV_API_PROXY=https://estudo-questoes.vercel.app
