# Cópia para `.env.local` e preencha só para `vercel dev` local (não commitar valores).
GEMINI_API_KEY=

# Opcional (padrão no código: gemini-2.5-flash — confere no AI Studio qual modelo tem quota)
# GEMINI_MODEL=gemini-2.5-flash

# Opcional: com `npm run dev`, encaminha `/api/*` para este URL (ex.: deploy na Vercel) para testar a página /ia sem `vercel dev`.
# DEV_API_PROXY=https://estudo-questoes.vercel.app
